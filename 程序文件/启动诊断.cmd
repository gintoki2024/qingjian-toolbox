@echo off
chcp 65001 >nul
setlocal
set "PSModulePath=%SystemRoot%\System32\WindowsPowerShell\v1.0\Modules"
set "QINGJIAN_DIAGNOSTIC_DIR=%~dp0"
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -Command "$ErrorActionPreference='Continue'; $dir=[IO.Path]::GetFullPath($env:QINGJIAN_DIAGNOSTIC_DIR); $parent=Split-Path -Parent $dir.TrimEnd('\'); $targets=@((Join-Path $parent '启动青简工具箱.exe'),(Join-Path $dir '青简工具箱.exe')); $text= & { '青简工具箱启动诊断（仅检查，不调整系统设置）'; Get-Date -Format o; Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion' | Select-Object ProductName,DisplayVersion,CurrentBuild,UBR | Format-List; foreach($file in $targets){ '文件：'+$file; if(Test-Path -LiteralPath $file){ Get-Item -LiteralPath $file | Select-Object Length,LastWriteTime | Format-List; Get-FileHash -LiteralPath $file -Algorithm SHA256 | Format-List; Get-Acl -LiteralPath $file | Select-Object Owner,AccessToString | Format-List; '下载来源标记（没有输出表示没有该数据流）：'; Get-Content -LiteralPath $file -Stream Zone.Identifier -ErrorAction SilentlyContinue; '当前兼容性设置：'; foreach($key in @('HKCU:\Software\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\Layers','HKLM:\Software\Microsoft\Windows NT\CurrentVersion\AppCompatFlags\Layers')){ $value=Get-ItemProperty -LiteralPath $key -Name $file -ErrorAction SilentlyContinue; if($value){ $value.PSObject.Properties | Where-Object Name -eq $file | Format-List Name,Value } } } else { '文件不存在，请完整解压。' } }; '最近24小时与本程序名称有关的系统事件：'; foreach($log in @('Microsoft-Windows-AppLocker/EXE and DLL','Microsoft-Windows-CodeIntegrity/Operational','Microsoft-Windows-Windows Defender/Operational','Application')){ '日志：'+$log; try { $events=Get-WinEvent -FilterHashtable @{LogName=$log;StartTime=(Get-Date).AddDays(-1)} -MaxEvents 200 -ErrorAction Stop | Where-Object { $_.Message -match '青简|Qingjian|SourceLauncher|PortableLauncher' } | Select-Object -First 10 TimeCreated,Id,ProviderName,Message; if($events){ $events | Format-List }else{ '未发现匹配事件。' } }catch{ '没有可读取的事件：'+$_.Exception.Message } }; '没有匹配事件不能排除公司终端防护拦截，请结合完整错误提示核查。' } | Out-String -Width 220; $dest=Join-Path $dir '启动诊断'; try { New-Item -ItemType Directory -Force -Path $dest -ErrorAction Stop | Out-Null }catch{ $dest=Join-Path $env:LOCALAPPDATA '青简工具箱\启动诊断'; New-Item -ItemType Directory -Force -Path $dest -ErrorAction Stop | Out-Null }; $report=Join-Path $dest ('启动诊断-'+(Get-Date -Format yyyyMMdd-HHmmss)+'.txt'); $text | Set-Content -LiteralPath $report -Encoding UTF8; Write-Host ('诊断已保存：'+$report); Write-Host '可将该文件和 Windows 的完整报错提供给本机管理员。'"
if /i "%~1"=="--no-pause" exit /b %errorlevel%
pause
endlocal
